ENVIRONMENT=development
PROJECT_NAME="Unibooks API - Universidad de Cundinamarca"
API_V1_STR=/api/v1
DEBUG=True

# Configuración por defecto para desarrollo local (Puede cambiarse a PostgreSQL de Supabase)
DATABASE_URL=sqlite:///./unibooks_dev.db

# Modo desarrollo de Firebase habilitado para testing local sin credenciales externas
FIREBASE_CREDENTIALS_PATH=
FIREBASE_DEV_MODE=True

INSTITUTIONAL_EMAIL_DOMAIN=ucundinamarca.edu.co
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080","*"]
