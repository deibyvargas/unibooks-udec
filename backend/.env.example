# ==============================================================================
# UNIBOOKS - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# Entorno: development | production | testing
ENVIRONMENT=development
PROJECT_NAME="Unibooks API - Universidad de Cundinamarca"
API_V1_STR=/api/v1
DEBUG=True

# Base de Datos (PostgreSQL en Supabase / Neon / Local)
# Si no se define o se usa local para testing, puede usar SQLite temporal para pruebas
DATABASE_URL=postgresql://postgres:tu_password_aqui@db.tu_proyecto_supabase.supabase.co:5432/postgres

# Firebase Configuration
# Para producción, coloca la ruta absoluta o relativa a tu archivo json de credenciales de Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Permitir modo emulado/desarrollo sin credenciales Firebase (muy útil para pruebas locales)
FIREBASE_DEV_MODE=True

# Dominio institucional requerido
INSTITUTIONAL_EMAIL_DOMAIN=ucundinamarca.edu.co

# Seguridad CORS (Orígenes permitidos separados por comas)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080","*"]
